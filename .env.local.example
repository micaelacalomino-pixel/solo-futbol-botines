# URL de la Sheet publicada como CSV (ver README para el paso a paso)
CATALOGO_CSV_URL=https://docs.google.com/spreadsheets/d/e/TU_ID_PUBLICADO/pub?gid=0&single=true&output=csv

# Tu numero de WhatsApp con codigo de pais, sin +, sin espacios (ej. 5491122334455)
# El prefijo NEXT_PUBLIC_ es obligatorio: el boton arma el link del lado del navegador
NEXT_PUBLIC_WHATSAPP_NUMERO=5491100000000
